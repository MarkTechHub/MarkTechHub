# Ignore editor and system files
.vscode/
.DS_Store
Thumbs.db
*.log

# Ignore PHPStorm / JetBrains IDE files
.idea/

# Ignore OS generated files
desktop.ini

# Ignore node modules if any
node_modules/

# Ignore package locks if generated locally
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore Composer files if any
vendor/
composer.lock

# Ignore compiled CSS or JS build artifacts
dist/
build/

# Ignore environment files
.env
.env.local

# Ignore XAMPP runtime files
xampp/tmp/

# Ignore GitHub Desktop metadata
*.db
